// KarbonShrunkhala — Prisma Database Schema
// Database: Supabase PostgreSQL
// Blueprint: 03-Backend-Schema.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================================================================
// Enums
// ================================================================

enum Role {
  NGO
  VERIFIER
  GOVERNMENT
  CORPORATE
}

enum EcosystemType {
  MANGROVE
  SEAGRASS
  SALT_MARSH
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_VERIFICATION
  APPROVED
  REJECTED
  CREDITS_ISSUED
}

enum VerificationDecision {
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum MarketplaceStatus {
  ACTIVE
  SOLD
  REMOVED
}

// ================================================================
// Models
// ================================================================

/// User Profile model linked 1-to-1 with Supabase Auth User ID
model Profile {
  id               String   @id @db.Uuid
  fullName         String   @map("full_name")
  email            String   @unique
  role             Role     @default(NGO)
  organizationName String?  @map("organization_name")
  phoneNumber      String?  @map("phone_number")
  avatarUrl        String?  @map("avatar_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  projects            Project[]            @relation("UserProjects")
  uploadedDocuments   ProjectDocument[]    @relation("UserUploadedDocuments")
  verifications       Verification[]       @relation("VerifierDecisions")
  marketplaceListings MarketplaceListing[] @relation("SellerListings")
  transactions        Transaction[]        @relation("BuyerTransactions")
  notifications       Notification[]       @relation("UserNotifications")
  auditLogs           AuditLog[]           @relation("UserAuditLogs")

  @@map("profiles")
}

/// Blue Carbon Project model
model Project {
  id            String        @id @default(uuid()) @db.Uuid
  ownerId       String        @map("owner_id") @db.Uuid
  projectName   String        @map("project_name")
  description   String        @db.Text
  ecosystemType EcosystemType @map("ecosystem_type")
  areaHectares  Decimal       @map("area_hectares") @db.Decimal(10, 2)
  state         String
  district      String
  geojsonUrl    String?       @map("geojson_url")
  status        ProjectStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  owner            Profile           @relation("UserProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  documents        ProjectDocument[] @relation("ProjectDocuments")
  satelliteReports SatelliteReport[] @relation("ProjectSatelliteReports")
  verifications    Verification[]    @relation("ProjectVerifications")
  carbonCredits    CarbonCredit[]    @relation("ProjectCarbonCredits")

  @@map("projects")
}

/// Project Evidence & Document Model
model ProjectDocument {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  fileName   String   @map("file_name")
  fileType   String   @map("file_type")
  storageUrl String   @map("storage_url")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Relations
  project  Project @relation("ProjectDocuments", fields: [projectId], references: [id], onDelete: Cascade)
  uploader Profile @relation("UserUploadedDocuments", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("project_documents")
}

/// Satellite NDVI & EVI Monitoring Reports Model
model SatelliteReport {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  reportDate       DateTime @map("report_date")
  meanNdvi         Decimal  @map("mean_ndvi") @db.Decimal(5, 4)
  meanEvi          Decimal  @map("mean_evi") @db.Decimal(5, 4)
  vegetationHealth String   @map("vegetation_health")
  satelliteSource  String   @default("Sentinel-2") @map("satellite_source")
  reportUrl        String?  @map("report_url")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation("ProjectSatelliteReports", fields: [projectId], references: [id], onDelete: Cascade)

  @@map("satellite_reports")
}

/// Verifier Decision Model
model Verification {
  id         String               @id @default(uuid()) @db.Uuid
  projectId  String               @map("project_id") @db.Uuid
  verifierId String               @map("verifier_id") @db.Uuid
  decision   VerificationDecision
  remarks    String?              @db.Text
  verifiedAt DateTime             @default(now()) @map("verified_at")

  // Relations
  project  Project @relation("ProjectVerifications", fields: [projectId], references: [id], onDelete: Cascade)
  verifier Profile @relation("VerifierDecisions", fields: [verifierId], references: [id], onDelete: Cascade)

  @@map("verifications")
}

/// Minted Carbon Credit Model
model CarbonCredit {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @map("project_id") @db.Uuid
  quantity           Decimal  @db.Decimal(12, 2)
  tokenId            String?  @map("token_id")
  blockchainTx       String?  @map("blockchain_tx")
  calculatedAmount   Decimal? @map("calculated_amount") @db.Decimal(12, 2)
  isOverridden       Boolean  @default(false) @map("is_overridden")
  overrideReason     String?  @map("override_reason") @db.Text
  calculationInputs  Json?    @map("calculation_inputs")
  methodologyVersion String   @default("IPCC-2013-VM0033-v1.0") @map("methodology_version")
  issuedAt           DateTime @default(now()) @map("issued_at")

  // Relations
  project  Project              @relation("ProjectCarbonCredits", fields: [projectId], references: [id], onDelete: Cascade)
  listings MarketplaceListing[] @relation("CreditMarketplaceListings")

  @@map("carbon_credits")
}

/// Marketplace Credit Listing Model
model MarketplaceListing {
  id                String            @id @default(uuid()) @db.Uuid
  creditId          String            @map("credit_id") @db.Uuid
  sellerId          String            @map("seller_id") @db.Uuid
  pricePerCredit    Decimal           @map("price_per_credit") @db.Decimal(10, 2)
  quantityAvailable Decimal           @map("quantity_available") @db.Decimal(12, 2)
  status            MarketplaceStatus @default(ACTIVE)
  listedAt          DateTime          @default(now()) @map("listed_at")

  // Relations
  credit       CarbonCredit  @relation("CreditMarketplaceListings", fields: [creditId], references: [id], onDelete: Cascade)
  seller       Profile       @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("ListingTransactions")

  @@map("marketplace_listings")
}

/// Corporate Purchase Transaction Model
model Transaction {
  id            String   @id @default(uuid()) @db.Uuid
  buyerId       String   @map("buyer_id") @db.Uuid
  marketplaceId String   @map("marketplace_id") @db.Uuid
  quantity      Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(12, 2)
  blockchainTx  String?  @map("blockchain_tx")
  purchasedAt   DateTime @default(now()) @map("purchased_at")

  // Relations
  buyer          Profile             @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  listing        MarketplaceListing  @relation("ListingTransactions", fields: [marketplaceId], references: [id], onDelete: Cascade)
  esgCertificate ESGCertificate?     @relation("TransactionCertificate")

  @@map("transactions")
}

/// ESG Ownership Certificate Model
model ESGCertificate {
  id             String   @id @default(uuid()) @db.Uuid
  transactionId  String   @unique @map("transaction_id") @db.Uuid
  certificateUrl String   @map("certificate_url")
  ipfsHash       String?  @map("ipfs_hash")
  generatedAt    DateTime @default(now()) @map("generated_at")

  // Relations
  transaction Transaction @relation("TransactionCertificate", fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("esg_certificates")
}

/// User Notification Model
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user Profile @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// System Governance Audit Log Model
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user Profile? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
